{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["src/**/*", "env.d.ts"],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "strict": true,
    "moduleResolution": "bundler",
    "target": "ESNext",
    "module": "ESNext",
    "skipLibCheck": true,
    "noEmit": true
  }
}
